# 复制为 .env / .env.development / .env.production 后按环境填写
# 所有自定义变量必须以 VITE_ 开头才会暴露给客户端（不要在 .env 中放敏感信息）

VITE_APP_TITLE=MutiDoc
VITE_API_BASE_URL=/api
VITE_REQUEST_TIMEOUT=10000

# true：使用各模块内置 mock，无需后端即可运行
# false：请求真实后端（开发环境经 DEV_PROXY_TARGET 代理）
VITE_USE_MOCK=false

# 协作编辑 WebSocket 端点（可选）。留空时按当前 origin + VITE_API_BASE_URL 推导：
#   ws(s)://<host>/api/doc/v1/document/edit?document_id=<id>
# VITE_COLLAB_WS_URL=

# 仅 Vite dev server 使用（非 VITE_ 前缀，不会暴露给客户端）
DEV_PROXY_TARGET=http://localhost:8888

# 开发兼容层：把带查询参数的 GET /api 请求转成 JSON body 转发给后端
# （后端部分 GET 接口要求 body，而浏览器禁止 GET 带 body）。默认开启，可设为 false 关闭。
DEV_GET_BODY_SHIM=true
